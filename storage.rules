rules_version = '2';

// TWin AR - Firebase Storage Security Rules, Phase 8.7 + Phase 8.8 + Phase 9.2 R10.
//
// Four isolated trees:
//  - `products/{productId}/images/{imageId}` - product photography. Public
//    read (matches `products/{id}`'s Firestore read rule - any signed-in
//    customer, and unauthenticated browsing of a shared product link, can
//    already see published+active product data); write restricted to the
//    `superAdmin` custom claim, mirroring `firestore.rules`' `isAdmin()`.
//  - `users/{uid}/profile/{imageId}` - a customer's own avatar. Deliberately
//    NOT public: only the owning uid or a superAdmin may read it (see
//    `09_BACKEND_INTEGRATION_PLAN.md`, Phase 8.7 - "Read-access decision:
//    owner + admin only"). The app never reads this via a public download
//    URL; it always fetches bytes through an authenticated
//    `FirebaseStorage.ref(path).getData()` call, which rules like these
//    correctly gate.
//  - `categories/{categoryId}/images/{imageId}` (Phase 8.8) - category
//    thumbnails. Public read, mirroring product images; write restricted to
//    the `superAdmin` custom claim, same as products.
//  - `products/{productId}/ar/model-v{version}.glb` (Phase 9.2 R10, made
//    metadata-driven in the §17 follow-up) - the versioned Room-AR 3D model
//    for a product. Deliberately NOT public (unlike product images): only a
//    *signed-in* customer may read it, and only when that exact product's
//    own live Firestore document says it is a published, active, enabled
//    `roomAr` product with a complete, well-formed `ar*` contract whose
//    `arModelStoragePath` names this exact object (a cross-service read of
//    Firestore from within this Storage rule - see `isApprovedArProduct()`
//    below). No product id is hardcoded; a new Admin-created product becomes
//    readable the moment its own document qualifies. Writes are
//    `superAdmin`-only, `.glb`-shaped, size-capped, and content-type gated -
//    exactly matching what `scripts/upload_ar_models/` sends and what
//    `RoomArModelService` will accept on the client. No listing, no wildcard.
//
// Both trees additionally restrict content-type (JPEG/PNG/WebP only) and
// size (10 MB product images, 2 MB avatars) on every create/update, and gate
// delete as its own rule, separate from create/update, so a client that can
// write a new image cannot be assumed to also be allowed to delete one (in
// practice the same `isAdmin()`/`isOwner(uid)` boundary applies to both
// here, but keeping them as distinct `allow` blocks matches the project's
// existing `firestore.rules` convention of not conflating operations).
//
// Rules are scoped to exact, known path shapes (`.../images/{imageId}`,
// `.../profile/{imageId}` - a single final path segment, not a `{**}`
// wildcard) so nothing under an unexpected sub-path is ever implicitly
// readable/writable. Everything else in the bucket is denied by the
// catch-all at the bottom, matching `firestore.rules`' pattern of leaving
// nothing open "for later".
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'superAdmin';
    }

    function isValidImageType() {
      return request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp';
    }

    // Phase 9.2 R10. The Admin SDK upload tool sets `model/gltf-binary`
    // explicitly; `application/octet-stream` is accepted as the generic
    // fallback Firebase reports for an unknown binary. Nothing else.
    function isValidArModelType() {
      return request.resource.contentType == 'model/gltf-binary'
          || request.resource.contentType == 'application/octet-stream';
    }

    // Phase 9.2 R16 — integrity provenance. Every AR-model write (Admin app
    // OR the `scripts/upload_ar_models/` Admin-SDK tool) MUST carry the
    // `twinArAr*` custom metadata: at minimum a 64-hex SHA-256 and a numeric
    // version. This makes "which bytes are these / what version" verifiable
    // from the object alone and blocks a bare/anonymous binary from ever
    // landing under `products/{id}/ar/`. Rules cannot hash the payload, so
    // this asserts the *shape* of the declared provenance, not that the hash
    // matches the bytes (RoomArModelService + the Admin re-download do that).
    function hasArModelProvenance() {
      return request.resource.metadata != null
          && request.resource.metadata.twinArArModelSha256 is string
          && request.resource.metadata.twinArArModelSha256.matches('[0-9a-f]{64}')
          && request.resource.metadata.twinArArModelVersion is string
          && request.resource.metadata.twinArArModelVersion.matches('[0-9]+');
    }

    // Phase 9.3 Stage 3 — Virtual Try-On garment reference images. A raster
    // photo, JPEG or PNG only (the try-on provider and the `VtoGarmentAsset`
    // contract accept nothing else).
    function isValidVtoGarmentType() {
      return request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png';
    }

    // Phase 9.3 Stage 3 — integrity provenance, mirroring `hasArModelProvenance`.
    // Every garment-image write MUST carry a 64-hex SHA-256 and a numeric
    // version in custom metadata, so a bare/anonymous image can never land
    // under `products/{id}/vto/`. Rules cannot hash the payload — this asserts
    // the declared shape; the Admin re-download re-verifies the bytes.
    function hasVtoGarmentProvenance() {
      return request.resource.metadata != null
          && request.resource.metadata.twinArVtoSha256 is string
          && request.resource.metadata.twinArVtoSha256.matches('[0-9a-f]{64}')
          && request.resource.metadata.twinArVtoVersion is string
          && request.resource.metadata.twinArVtoVersion.matches('[0-9]+');
    }

    // Phase 9.3 Stage 4 — Virtual Try-On customer photos/results. A raster
    // photo or generated preview, JPEG or PNG only. Same allowed set as
    // `isValidVtoGarmentType()` (Stage 3); kept as its own function so that
    // approved Stage-3 rule is never touched by this Stage-4 change.
    function isValidVtoPersonPhotoType() {
      return request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png';
    }

    // Phase 9.2 §17-follow-up — REPLACES the old hardcoded product-id
    // allowlist with a live, metadata-driven authorization check against the
    // product's own Firestore document. Cross-service (Storage rules reading
    // Firestore) — both emulators run from one `firebase.json` locally;
    // `firestore.get()`/`firestore.exists()` are cached per evaluation, so
    // this costs one extra Firestore read per Storage read, not two.
    //
    // A customer may read `products/{productId}/ar/{modelFile}` only when
    // ALL of the following hold on the LIVE `products/{productId}` document
    // (an admin-only-writable document — see firestore.rules `isAdmin()` —
    // so trusting its fields here carries exactly the same trust boundary
    // Firestore itself already places on that document):
    //  - the document exists;
    //  - it is customer-visible: `publicationStatus == 'published'` and
    //    `isActive == true` (the exact same pair firestore.rules' own
    //    `products/{id}` read rule already requires — `showInCatalog` is
    //    deliberately NOT part of this, matching that rule);
    //  - `experienceType == 'roomAr'`;
    //  - `arModelDisabled` is not `true` (absent/false = enabled, matching
    //    the mapper's "written only when true" convention);
    //  - its `arModelStoragePath` is EXACTLY this product's own
    //    `products/{productId}/ar/{modelFile}` path — the defence against a
    //    cross-product path that `ProductArMetadata.belongsToProduct` also
    //    enforces client-side (tracker §17.3) is now enforced server-side too;
    //  - the rest of the `ar*` contract is present and well-formed (format,
    //    version, a 64-hex sha256, positive bounded dimensions and scale, a
    //    non-empty scale-contract id) — mirrors
    //    `ProductArMetadata._issues()`/`isRenderable` so a document that the
    //    client itself would refuse to render can never be read either.
    //
    // No product id is hardcoded anywhere in this function. A brand-new
    // Admin-created product becomes readable the instant its Firestore
    // document satisfies these conditions — no rules edit, no redeploy.
    function arDocPath(productId) {
      return /databases/(default)/documents/products/$(productId);
    }

    // Every field is read via `.get(key, default)`, never bare `doc.key` —
    // the rules language THROWS (not "null") on a genuinely absent map key,
    // and an uncaught throw denies the whole request anyway, but a mismatched
    // default (`''`/`0`/`false`) makes a missing field fail its own specific
    // check cleanly instead of aborting evaluation of the function entirely.
    // `arModelDisabled` in particular is written only-when-true by the
    // mapper, so its absence must mean "enabled", not "malformed".
    function hasRenderableArMetadata(doc, productId, modelFile) {
      return doc.get('publicationStatus', '') == 'published'
          && doc.get('isActive', false) == true
          && doc.get('experienceType', '') == 'roomAr'
          && doc.get('arModelDisabled', false) != true
          && doc.get('arModelStoragePath', '')
              == 'products/' + productId + '/ar/' + modelFile
          && doc.get('arModelFormat', '') == 'glb'
          && doc.get('arModelVersion', '') is string
          && doc.get('arModelVersion', '').size() > 0
          && doc.get('arModelSha256', '') is string
          && doc.get('arModelSha256', '').matches('^[0-9a-f]{64}$')
          && doc.get('arWidthM', 0) is number
          && doc.get('arWidthM', 0) > 0 && doc.get('arWidthM', 0) <= 100
          && doc.get('arDepthM', 0) is number
          && doc.get('arDepthM', 0) > 0 && doc.get('arDepthM', 0) <= 100
          && doc.get('arHeightM', 0) is number
          && doc.get('arHeightM', 0) > 0 && doc.get('arHeightM', 0) <= 100
          && doc.get('arScale', 0) is number
          && doc.get('arScale', 0) > 0 && doc.get('arScale', 0) <= 10
          && doc.get('arScaleContract', '') is string
          && doc.get('arScaleContract', '').size() > 0;
    }

    function isApprovedArProduct(productId, modelFile) {
      return firestore.exists(arDocPath(productId))
          && hasRenderableArMetadata(
               firestore.get(arDocPath(productId)).data,
               productId,
               modelFile);
    }

    match /products/{productId}/images/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin()
                             && isValidImageType()
                             && request.resource.size <= 10 * 1024 * 1024;
      // Delete is intentionally unused by the app this phase - previously
      // committed product-image objects are never deleted (historical
      // OrderItemModel snapshots may still reference them) - but the rule
      // exists so a future cleanup tool has a correct, narrow boundary to
      // rely on rather than an open one.
      allow delete: if isAdmin();
    }

    match /users/{uid}/profile/{imageId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
                             && isValidImageType()
                             && request.resource.size <= 2 * 1024 * 1024;
      // Used for best-effort cleanup when a user replaces their avatar with
      // a new upload, and for rollback of a just-uploaded-this-session file
      // if the following Firestore write fails.
      allow delete: if isOwner(uid);
    }

    // Phase 8.8 - Dynamic Categories Foundation. Mirrors the
    // products/{productId}/images/{imageId} block exactly (public read,
    // superAdmin-only write, same JPEG/PNG/WebP gate), except for a smaller
    // 5 MB size ceiling - a category image is a single thumbnail, never a
    // multi-image gallery, so the product ceiling would be unnecessarily
    // generous. Does not change products/{productId}/images/{imageId} or
    // users/{uid}/profile/{imageId} in any way - both blocks above are
    // untouched.
    match /categories/{categoryId}/images/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin()
                             && isValidImageType()
                             && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Phase 9.2 R10 / R16 - versioned Room-AR GLB delivery.
    // `model-v{n}.glb` only - a single, exact final path segment, so
    // nothing under `products/{id}/ar/**` other than the model file itself
    // is ever readable or writable.
    //
    // Read:
    //  - a customer (signed-in) may read a product's model only when that
    //    product's own live Firestore document qualifies —
    //    `isApprovedArProduct()` above, metadata-driven, no hardcoded id
    //    list. Every product without a complete, matching, enabled `ar*`
    //    contract on its own document stays unreadable to customers.
    //  - an admin (superAdmin claim) may read ANY product's model - they can
    //    already write it (below), and R16's Admin AR & Media "preview /
    //    re-verify committed model" needs the exact bytes back. This is
    //    strictly a superset of the write privilege they already hold, so it
    //    adds no new exposure surface.
    // Write (`create`/`update`): superAdmin only, and ALL of —
    //   * `model-v{n}.glb` exact name shape (no listing, no wildcard, nothing
    //     else under `ar/` is writable);
    //   * `isValidArModelType()` — `model/gltf-binary` (Admin app + R10 tool)
    //     or `application/octet-stream` (SDK generic fallback), nothing else;
    //   * `hasArModelProvenance()` — a 64-hex `twinArArModelSha256` + numeric
    //     `twinArArModelVersion` in custom metadata (R16 integrity clarify —
    //     no anonymous binary can land here);
    //   * `size <= 12 MB` — the TRANSPORT ceiling. The Admin app caps its own
    //     uploads at the stricter SCALE_CONTRACT.md 8 MB authoring budget
    //     (`kArModelMaxUploadBytes`); 12 MB here is the safety margin that
    //     also matches `RoomArModelService.defaultMaxDownloadBytes`.
    // Delete: superAdmin + `.glb` name shape — deliberately nothing more.
    // There is no request payload to validate on a delete, and rules must not
    // try to encode app workflow (the R16 "disable the customer entry point
    // before you may delete" ordering is enforced in the ViewModel, not here;
    // a superAdmin with console access can always delete regardless). The R10
    // tool never deletes; the R16 "permanently delete model" flow and any
    // future cleanup tool rely on exactly this boundary.
    match /products/{productId}/ar/{modelFile} {
      allow read: if modelFile.matches('model-v[0-9]+[.]glb')
                   && (isAdmin()
                       || (isSignedIn()
                           && isApprovedArProduct(productId, modelFile)));
      allow create, update: if isAdmin()
                             && modelFile.matches('model-v[0-9]+[.]glb')
                             && isValidArModelType()
                             && hasArModelProvenance()
                             && request.resource.size <= 12 * 1024 * 1024;
      allow delete: if isAdmin()
                     && modelFile.matches('model-v[0-9]+[.]glb');
    }

    // Phase 9.3 Stage 3 - versioned Virtual Try-On garment images.
    // `garment-{slot}-v{n}.{jpg|jpeg|png}` only - a single exact final path
    // segment (`{slot}` is a colour name or the literal `default`), so nothing
    // else under `products/{id}/vto/**` is ever readable or writable.
    //
    // Read: any SIGNED-IN user (developer decision D8 - deliberately tighter
    // than product images, which are public; a garment reference image is an
    // authoring asset, not storefront photography). NOT metadata-gated like the
    // AR model - a garment image carries no customer risk if seen early, and
    // the customer try-on flow (a later stage) reads it server-side via the
    // Admin SDK anyway. The Admin uploader sets `Cache-Control: private, ...,
    // immutable` - consistent with a signed-in-only read (no shared/CDN
    // caching) and safe because a create-only versioned object never changes.
    // Write is CREATE-ONLY. Each version has a distinct object name
    // (`garment-{slot}-v{n}`), so its bytes are immutable under that path: an
    // `update` (an overwrite of an existing object) would silently diverge the
    // bytes from the SHA-256 already recorded in the product's Firestore
    // contract and from any cached copy. `allow update: if false` enforces
    // that. The Admin flow only ever uploads a NEW version number (or
    // re-`create`s after a rollback deleted the object), so it never needs
    // `update`. `create`: superAdmin only, and ALL of -
    //   * `garment-{slot}-v{n}.{ext}` exact name shape;
    //   * `isValidVtoGarmentType()` - `image/jpeg` or `image/png`, nothing else;
    //   * `hasVtoGarmentProvenance()` - 64-hex `twinArVtoSha256` + numeric
    //     `twinArVtoVersion` in custom metadata;
    //   * `size < 12 MiB` - the TRANSPORT ceiling. The Admin app caps its own
    //     uploads at the stricter 8 MiB authoring budget
    //     (`kVtoGarmentMaxUploadBytes`) client-side.
    // Delete: superAdmin + the name shape - deliberately nothing more (the
    // "disable the entry point before you may delete" ordering is enforced in
    // the ViewModel, not here; a superAdmin with console access can always
    // delete regardless). Rollback of a just-uploaded object, the "remove VTO
    // config" flow and the product-delete cleanup all rely on exactly this.
    match /products/{productId}/vto/{assetFile} {
      allow read: if isSignedIn();
      // CREATE-ONLY: `resource == null` means the object does not exist yet, so
      // an overwrite of an existing version is denied (the Storage emulator
      // classifies every `putFile` as a write/create regardless of occupancy,
      // so `allow update: if false` alone does NOT stop an overwrite — the
      // `resource == null` guard is what enforces immutability).
      allow create, update: if isAdmin()
                             && resource == null
                             && assetFile.matches('garment-[a-zA-Z0-9]+-v[0-9]+[.](jpg|jpeg|png)')
                             && isValidVtoGarmentType()
                             && hasVtoGarmentProvenance()
                             && request.resource.size < 12 * 1024 * 1024;
      allow delete: if isAdmin()
                     && assetFile.matches('garment-[a-zA-Z0-9]+-v[0-9]+[.](jpg|jpeg|png)');
    }

    // Phase 9.3 Stage 4 — Virtual Try-On customer person-photo upload.
    // `{sessionId}.jpg` only, where `{sessionId}` is the 64-hex SHA-256 the
    // Cloud Function derives from `(uid, idempotencyKey)`
    // (`tryOnSessionIdFor` in `functions/src/lib/tryOn/session.ts`) — a
    // single exact final path segment, so nothing else under
    // `users/{uid}/tryOnUploads/**` is ever readable or writable, and a
    // client can never guess or collide another user's object name space.
    // Read: owner or admin only — this is raw customer biometric imagery,
    // never public, never shared, unlike product photography.
    // Create: owner only, JPEG/PNG, size-capped. CREATE-ONLY (`resource ==
    // null`, the same immutability guard the Stage 3 garment block uses) —
    // once uploaded for a given attempt, that exact object never changes
    // under the client; a genuinely new attempt uses a new idempotency key
    // and therefore a new `{sessionId}`.
    // Delete: owner (a client-side cleanup / abandoned-attempt tidy-up) or
    // admin. `generateTryOn` deletes it itself via the Admin SDK (which
    // bypasses this rule) immediately after every generation, success or
    // failure (D4) — this client delete path exists only as a courtesy, e.g.
    // if the customer cancels before ever calling `generateTryOn`.
    match /users/{uid}/tryOnUploads/{sessionFile} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                     && resource == null
                     && sessionFile.matches('[0-9a-f]{64}[.]jpg')
                     && isValidVtoPersonPhotoType()
                     && request.resource.size <= 12 * 1024 * 1024;
      allow update: if false;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Phase 9.3 Stage 4 — Virtual Try-On generated preview.
    // `{sessionId}.jpg` OR `{sessionId}.png` — the Cloud Function saves the
    // result under whichever extension matches the provider output's own
    // VERIFIED content type (Gemini image output is commonly PNG; 2026-09-11
    // hardening — never save a PNG under a misleading `.jpg` name). Write is
    // FUNCTION-ONLY (`generateTryOn`, via the Admin SDK, which bypasses this
    // rule) — `allow create, update: if false` for every client, including a
    // superAdmin, so a client can never fabricate or overwrite a "result";
    // the name-shape regex on read/delete is a defence-in-depth tightening,
    // not the security boundary (create/update already deny everyone).
    // Read: owner or admin only (§10 — this is a generated image of the
    // customer, not storefront photography). Delete: owner (the Stage 5
    // "delete this preview" / "leave the result flow" action, and the
    // Profile "delete my try-on data" affordance) or admin; the scheduled
    // `cleanupExpiredTryOnMedia` sweep also deletes via the Admin SDK.
    match /users/{uid}/tryOnResults/{sessionFile} {
      allow read: if (isOwner(uid) || isAdmin())
                   && sessionFile.matches('[0-9a-f]{64}[.](jpg|png)');
      allow create, update: if false;
      allow delete: if (isOwner(uid) || isAdmin())
                     && sessionFile.matches('[0-9a-f]{64}[.](jpg|png)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
