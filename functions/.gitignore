# Build output — the `tsc` emit dir ONLY. Anchored with a leading slash so it
# matches `functions/lib/` and NOT `functions/src/lib/**` (the real Cloud
# Functions business-logic layer, which IS tracked).
/lib/

# Dependencies
node_modules/

# Secret material - NEVER commit. Stripe keys are provided only through
# Firebase Secret Manager (server) and secure local build config (Flutter
# publishable key). No key belongs in a committed file.
.env
.env.*
.runtimeconfig.json
*.local

# Firebase tooling
.firebase/
*-debug.log
